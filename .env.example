DOCUPILOT_ENV=local
DOCUPILOT_LOG_LEVEL=INFO
DOCUPILOT_API_HOST=0.0.0.0
DOCUPILOT_API_PORT=8000
DOCUPILOT_REDIS_URL=redis://localhost:6379/0
DOCUPILOT_REPOSITORY_BACKEND=memory
DOCUPILOT_POSTGRES_URL=postgresql+psycopg://docupilot:docupilot@localhost:5432/docupilot
DOCUPILOT_OBJECT_STORE_ROOT=local/object-store
DOCUPILOT_AUTH_SECRET=docupilot-dev-secret-change-me
DOCUPILOT_SESSION_TTL_SECONDS=43200
DOCUPILOT_DISABLE_SIGNUP=false
# Optional: set a positive integer to limit Celery worker parallelism.
# DOCUPILOT_WORKER_CONCURRENCY=1
# Optional timeout in seconds for model requests (API and worker).
# DOCUPILOT_LLM_REQUEST_TIMEOUT_SECONDS=300
